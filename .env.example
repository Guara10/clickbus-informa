# Somente referencia. Nao inclua senhas reais no projeto.
ORACLE_DSN=seu-host:1521/seu-service-name
ORACLE_USER=usuario
ORACLE_PASSWORD=senha
SMS_API_URL=https://api.seu-provedor.com
SMS_API_TOKEN=token

# Motor preditivo -- clima (Open-Meteo) ja funciona sem chave.
# Sem GOOGLE_MAPS_API_KEY, o transito e simulado (marcado como "simulado" na resposta da API).
GOOGLE_MAPS_API_KEY=

# WhatsApp (Twilio Sandbox). Sem essas 3 variaveis, o envio e simulado
# (mesmo padrao do /api/simular-sms). Sandbox e gratuito: console.twilio.com > Messaging > Try it out > WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Unico numero que recebe WhatsApp de verdade (o seu, cadastrado no Sandbox). Formato E.164.
# Os contatos da base sao ficticios e nunca recebem mensagem.
WHATSAPP_DESTINO_TESTE=

# 1 = nao consulta o Open-Meteo (testes ou apresentacao sem internet)
MOTOR_OFFLINE=
